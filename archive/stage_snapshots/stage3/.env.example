# ==========================================
# CyberSahayak — Environment Configuration
# ==========================================

# Active LLM Provider (options: 'google' | 'openai')
LLM_PROVIDER=google

# Google Gemini API Key (when LLM_PROVIDER=google)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (when LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Preferred model override (e.g., gemini-1.5-flash, gpt-4o-mini)
LLM_MODEL=

# Server runtime port (default: 3000)
PORT=3000
