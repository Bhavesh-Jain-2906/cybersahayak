# ==============================================================================
# CyberSahayak — Environment Configuration Template
# NOTE: Never commit .env or .env.local with real secrets to version control.
# ==============================================================================

# LLM Provider Selection: 'groq' | 'google' | 'demo'
LLM_PROVIDER=groq

# Groq API Configuration
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API Configuration
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here
GOOGLE_MODEL=gemini-1.5-flash

# Optional: Tavily Search API
TAVILY_API_KEY=your_tavily_api_key_here

# RAG & Embeddings Configuration: 'local' | 'google' | 'openai'
# 'local': 256-dim zero-config dense TF-IDF (no API key needed, offline-ready)
# 'google': Google text-embedding-004
# 'openai': OpenAI text-embedding-3-small
EMBEDDING_PROVIDER=local
