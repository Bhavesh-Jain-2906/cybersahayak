# Connor Environment Configuration Template
# Copy this file to .env.local and populate the values

# Primary LLM Provider: 'groq' | 'google' | 'demo'
LLM_PROVIDER=groq

# Groq API Configuration (High throughput inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini API Configuration (Alternative provider & embeddings)
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_MODEL=gemini-flash-latest

# Tavily Search API (Optional web search intelligence)
TAVILY_API_KEY=your_tavily_key_here

# RAG & Embeddings Configuration ('local', 'google', or 'openai')
EMBEDDING_PROVIDER=local

# Supabase Authentication & PostgreSQL Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_or_service_role_key_here

# Real Gmail OTP Email Delivery (Required to send 6/8-digit OTP & Password Reset codes)
GMAIL_USER=your.sender@gmail.com
GMAIL_APP_PASSWORD=your_16_char_google_app_password
# Optional alternative email provider:
# RESEND_API_KEY=your_resend_api_key_here
# RESEND_FROM=Connor Security <onboarding@resend.dev>
